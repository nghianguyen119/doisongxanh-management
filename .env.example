# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. For a hosted Postgres (Neon/Supabase) just
# replace this whole string; add ?sslmode=require if the host needs TLS.
DATABASE_URL="postgres://dsx:dsx@localhost:5432/dsx"

# --- Better Auth ----------------------------------------------------------
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-dev-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: signs the read-only "Việc của tôi" links sent to employees.
# Falls back to BETTER_AUTH_SECRET when empty, so links work without this.
# Rotating it (or BETTER_AUTH_SECRET) invalidates every existing link.
EMPLOYEE_LINK_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of Google account emails allowed into the manager
# portal. The first one that signs in becomes the admin. Leave empty during
# first local setup to allow any Google account (NOT for production).
# When pasting into a hosting dashboard (Vercel, etc.) paste the bare value:
#   you@company.com,ops@company.com   — do NOT include the surrounding quotes.
ALLOWED_MANAGER_EMAILS=""

# --- Zalo Official Account ----------------------------------------------
# "mock"  -> no network calls; outbound messages are logged to the DB and
#            the /settings/zalo simulator can inject inbound events.
# "live"  -> talks to the real Zalo OA Open API v3.0.
ZALO_TRANSPORT="mock"

# Required only when ZALO_TRANSPORT=live. From https://developers.zalo.me
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_SECRET=""
# Bootstrap tokens: after the first successful refresh they are persisted in
# the zalo_oa_token table and these env values are ignored.
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_REFRESH_TOKEN=""

# Bearer token for POST/GET /api/cron/reminders. Unset = endpoint disabled.
CRON_SECRET=""

# "true" = browse the manager portal without signing in as a fake admin
# ("dev@local"). Only honoured outside production; leave "false" when you
# want to test the sign-in flow itself.
AUTH_BYPASS="false"

# --- Sentry (optional error reporting) -------------------------------------
# DSN from the Sentry project (Settings -> Client Keys). Empty = Sentry is
# disabled everywhere, including the client bundle.
NEXT_PUBLIC_SENTRY_DSN=""

# Build-only: upload source maps during `pnpm build`. Leave empty and errors
# are still reported, just with minified stack traces.
SENTRY_AUTH_TOKEN="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"
SENTRY_ORG="doi-song-xanh"
SENTRY_PROJECT="4512070160678992"
